{
    "name": "dummy.dummy",
    "scripts": {
        "build": "mbt build --mtar dummy.dummy.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/dummy.dummy.mtar --retries 0",
        "lint": "npm run lint --workspaces --if-present",
        "ui5lint": "npm run ui5lint --workspaces --if-present",
        "start:myapp": "npm start --workspace myapp"
    },
    "dependencies": {
        "mbt": "^1"
    },
    "workspaces": [
        "myapp"
    ]
}